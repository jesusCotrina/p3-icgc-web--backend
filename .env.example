# Variables del backend cuando corre FUERA de Docker (npm run dev).
# El .env de la raiz es el que usa docker-compose; este lo usan el backend y
# el CLI de Prisma, que solo lee el .env de su propia carpeta.

NODE_ENV=development
PORT=4000

# Host "localhost" porque Postgres esta expuesto por docker-compose.
# Dentro de Docker el host es "db" (lo inyecta el compose).
DATABASE_URL=postgresql://icgc:icgc_dev_password@localhost:5432/icgc?schema=public

JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria-en-produccion
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@icgc.edu.pe
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrador ICGC

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500
PUBLIC_API_URL=http://localhost:4000

# Vacio = raiz del volumen donde viven los uploads (C:\ en Windows, / en Linux)
DISK_PATH=

# Regeneracion de paginas de la web al publicar (mismo secreto en frontend-web)
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
